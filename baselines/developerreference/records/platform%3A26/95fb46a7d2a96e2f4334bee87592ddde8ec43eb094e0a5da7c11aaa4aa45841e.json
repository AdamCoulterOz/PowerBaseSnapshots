    "offlinesqlquery": "/*SelectStart*/select  \"goal0\".[goalid] as \"goalid\"\r , \"goal0\".[title] as \"title\"\r , \"goal0\".[fiscalperiod] as \"fiscalperiod\"\r , \"goal0\".[fiscalyear] as \"fiscalyear\"\r , \"goal0\".[targetstring] as \"targetstring\"\r , \"goal0\".[percentage] as \"percentage\"\r , \"goal0\".[actualstring] as \"actualstring\"\r , \"goal0\".[inprogressstring] as \"inprogressstring\"\r , \"goal0\".[metricid!id] as \"metricid!id\"\r , \"goal0\".[metricid!logicalname] as \"metricid!logicalname\"\r , \"goal0\".[metricid!name] as \"metricid!name\"\r , \"goal0\".[parentgoalid!id] as \"parentgoalid!id\"\r , \"goal0\".[parentgoalid!logicalname] as \"parentgoalid!logicalname\"\r , \"goal0\".[parentgoalid!name] as \"parentgoalid!name\"\r , \"goal0\".[goalstartdate] as \"goalstartdate\"\r , \"goal0\".[goalenddate] as \"goalenddate\"/*SelectEnd*/  /*FromStart*/from  Goal as \"goal0\"/*FromEnd*/  /*WhereStart*/where  (\"goal0\".[statecode] = 0 and \"goal0\".[goalownerid!id] = \"!eq-userid!\")/*WhereEnd*/  /*OrderByStart*/order by  case \"goal0\".[fiscalperiod] when 1 then  'Quarter 1' when 2 then  'Quarter 2' when 3 then  'Quarter 3' when 4 then  'Quarter 4' when 101 then  'January' when 102 then  'February' when 103 then  'March' when 104 then  'April' when 105 then  'May' when 106 then  'June' when 107 then  'July' when 108 then  'August' when 109 then  'September' when 110 then  'October' when 111 then  'November' when 112 then  'December' when 201 then  'Semester 1' when 202 then  'Semester 2' when 301 then  'Annual' when 401 then  'P1' when 402 then  'P2' when 403 then  'P3' when 404 then  'P4' when 405 then  'P5' when 406 then  'P6' when 407 then  'P7' when 408 then  'P8' when 409 then  'P9' when 410 then  'P10' when 411 then  'P11' when 412 then  'P12' when 413 then  'P13' else null end  asc\r , \"goal0\".[title] asc/*OrderByEnd*/",
