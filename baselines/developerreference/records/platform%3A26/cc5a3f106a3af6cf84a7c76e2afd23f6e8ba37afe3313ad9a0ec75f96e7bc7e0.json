    "offlinesqlquery": "/*SelectStart*/select  \"mailbox0\".[name] as \"name\"\r , \"mailbox0\".[enabledforoutgoingemail] as \"enabledforoutgoingemail\"\r , \"mailbox0\".[enabledforincomingemail] as \"enabledforincomingemail\"\r , \"mailbox0\".[enabledforact] as \"enabledforact\"\r , \"mailbox0\".[statecode] as \"statecode\"\r , \"mailbox0\".[regardingobjectid!id] as \"regardingobjectid!id\"\r , \"mailbox0\".[regardingobjectid!logicalname] as \"regardingobjectid!logicalname\"\r , \"mailbox0\".[regardingobjectid!name] as \"regardingobjectid!name\"\r , \"mailbox0\".[outgoingemaildeliverymethod] as \"outgoingemaildeliverymethod\"\r , \"mailbox0\".[incomingemaildeliverymethod] as \"incomingemaildeliverymethod\"\r , \"mailbox0\".[actdeliverymethod] as \"actdeliverymethod\"\r , \"mailbox0\".[emailserverprofile!id] as \"emailserverprofile!id\"\r , \"mailbox0\".[emailserverprofile!logicalname] as \"emailserverprofile!logicalname\"\r , \"mailbox0\".[emailserverprofile!name] as \"emailserverprofile!name\"\r , \"mailbox0\".[emailaddress] as \"emailaddress\"\r , \"mailbox0\".[mailboxid] as \"mailboxid\"\r , \"mailbox0\".[ownerid!id] as \"ownerid!id\"\r , \"mailbox0\".[ownerid!logicalname] as \"ownerid!logicalname\"\r , \"mailbox0\".[ownerid!name] as \"ownerid!name\"\r , \"mailbox0\".[incomingemailstatus] as \"incomingemailstatus\"\r , \"mailbox0\".[outgoingemailstatus] as \"outgoingemailstatus\"\r , \"mailbox0\".[actstatus] as \"actstatus\"\r , \"mailbox0\".[testmailboxaccesscompletedon] as \"testmailboxaccesscompletedon\"\r , \"mailbox0\".[verboseloggingenabled] as \"verboseloggingenabled\"/*SelectEnd*/  /*FromStart*/from  Mailbox as \"mailbox0\"/*FromEnd*/  /*WhereStart*/where  (\"mailbox0\".[statecode] = 0 and (\"mailbox0\".[enabledforoutgoingemail] = 0 or \"mailbox0\".[enabledforincomingemail] = 0 or \"mailbox0\".[enabledforact] = 0))/*WhereEnd*/  /*OrderByStart*/order by  \"mailbox0\".[name] asc/*OrderByEnd*/",
