    "name": "SharePoint Document Quick Find View",
    "offlinesqlquery": "/*CTEStart*/WITH __QuickFind__ as (select [sharepointdocumentid] from (/*QuickFindStart*/\r SELECT \"sharepointdocument0\".[sharepointdocumentid] AS [sharepointdocumentid] FROM [SharePointDocument] AS \"sharepointdocument0\" \r  where (\"sharepointdocument0\".[locationid] like {0}) LIMIT 10001/*QuickFindEnd*/) as [__QuickFindInternal__])/*CTEEnd*//*SelectStart*/select  \"sharepointdocument0\".[fullname] as \"fullname\"\r , \"sharepointdocument0\".[documentid] as \"documentid\"\r , \"sharepointdocument0\".[locationid] as \"locationid\"\r , \"sharepointdocument0\".[title] as \"title\"\r , \"sharepointdocument0\".[author] as \"author\"\r , \"sharepointdocument0\".[modified] as \"modified\"\r , \"sharepointdocument0\".[sharepointcreatedon] as \"sharepointcreatedon\"\r , \"sharepointdocument0\".[sharepointmodifiedby] as \"sharepointmodifiedby\"\r , \"sharepointdocument0\".[readurl] as \"readurl\"\r , \"sharepointdocument0\".[editurl] as \"editurl\"\r , \"sharepointdocument0\".[sharepointdocumentid] as \"sharepointdocumentid\"\r , \"sharepointdocument0\".[filetype] as \"filetype\"\r , \"sharepointdocument0\".[ischeckedout] as \"ischeckedout\"\r , \"sharepointdocument0\".[absoluteurl] as \"absoluteurl\"\r , \"sharepointdocument0\".[iconclassname] as \"iconclassname\"/*SelectEnd*/  /*FromStart*/from  SharePointDocument as \"sharepointdocument0\"/*FromEnd*/  /*WhereStart*/where  [sharepointdocument0].[sharepointdocumentid] in (select [sharepointdocumentid] from [__QuickFind__])/*WhereEnd*/  /*OrderByStart*/order by  \"sharepointdocument0\".[relativelocation] asc/*OrderByEnd*/",
