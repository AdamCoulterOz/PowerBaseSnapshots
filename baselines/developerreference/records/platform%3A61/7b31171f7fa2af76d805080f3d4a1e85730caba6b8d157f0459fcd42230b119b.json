    "contentjson": "{\"importMap.Process\":\"Обрада је у току...\",\"text.errorMessage\":\"Одговор је резултирао грешком!\",\"text.errorOccured\":\"Дошло је до грешке:\",\"text.unpublish\":\"Опозовите објављивање изабраних правила за откривање дупликата. Правила чије је објављивање опозвано не користе се за откривање дупликата. Желите ли да опозовете објављивање изабраних правила.\",\"title.unpublish\":\"Опозивање објављивања правила\",\"text.publish\":\"Објављивање правила креира подударни кључ за сваки запис. Овај процес се обавља у позадини. Microsoft Dynamics 365 можете да наставите да користите током објављивања правила.\",\"title.publish\":\"Објављивање правила\",\"pick.list\":\"fieldpicklist\",\"text.req\":\"обавезан\",\"operationName.Unpublish\":\"UnpublishDuplicateRule\",\"operationName.Publish\":\"PublishDuplicateRule\",\"action.restore\":\"Желите ли да вратите {0} у претходно стање?\",\"action.restoreText\":\"Врати\",\"action.cancelText\":\"Откажи\",\"action.confirmRestore\":\"Потврди враћање у претходно стање\",\"action.errorText\":\"Грешка на мрежи\",\"action.restorationConfirm\":\"Потврда враћања {0} у претходно стање\",\"action.bodyText\":\"Желите ли заиста да вратите у претходно стање записе које је избрисала услуга {0}?\",\"action.okText\":\"У реду\",\"action.failedTitle\":\"Враћање у претходно стање није успело\",\"action.failedSubtitle\":\"Дошло је до грешке током обраде враћања у претходно стање.\",\"action.multiple.body\":\"Враћање {0} посла у претходно стање ће вратити све записе које је избрисао посао. Да бисте наставили са враћањем у претходно стање {0}, кликните на „У реду“.\",\"action.processingText\":\"Обрада је у току...\",\"action.entityTypeMissing\":\"Назив типа ентитета није могао да се одреди.\",\"action.restoreSuccess\":\"Успешно је враћено у претходно стање.\",\"action.learnMoreLabel\":\"Сазнајте више\"}",
