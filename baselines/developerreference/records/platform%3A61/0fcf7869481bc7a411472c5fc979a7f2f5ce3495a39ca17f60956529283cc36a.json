    "contentjson": "{\"Create_Major_Confirmation_DialogTitle\":\"Maken van hoofdversie van artikel bevestigen\",\"Create_Minor_Confirmation_DialogTitle\":\"Maken van secundaire versie van artikel bevestigen\",\"KnowledgeArticle_Approve_Confirmation_DialogText\":\"Weet u zeker dat u deze versie van het artikel wilt goedkeuren?\",\"KnowledgeArticle_Approve_Confirmation_DialogTitle\":\"Goedkeuring van een of meer artikelen bevestigen\",\"KnowledgeArticle_Archive_Confirmation_DialogText\":\"Weet u zeker dat u deze versie van het artikel wilt archiveren?\",\"KnowledgeArticle_Archive_Confirmation_DialogTitle\":\"Archivering van een of meer artikelen bevestigen\",\"KnowledgeArticle_AssociateArticleArticle_DialogText\":\"U moet een artikel selecteren.\",\"KnowledgeArticle_AssociateArticleCategory_DialogText\":\"U moet een categorie selecteren.\",\"KnowledgeArticle_BulkApprove_Confirmation_DialogText\":\"Weet u zeker dat u deze versie van het artikel wilt goedkeuren?\",\"KnowledgeArticle_BulkArchive_Confirmation_DialogText\":\"Weet u zeker dat u deze versie van het artikel wilt archiveren?\",\"KnowledgeArticle_BulkDiscard_Confirmation_DialogText\":\"Weet u zeker dat u deze versie van het artikel naar de prullenbak wilt verplaatsen?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogText\":\"Weet u zeker dat u een nieuwe hoofdversie van dit artikel wilt maken?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogTitle\":\"Maken van hoofdversie van een of meer artikelen bevestigen\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogText\":\"Een of meer geselecteerde artikelen worden gemarkeerd als extern. Weet u zeker dat u wilt doorgaan?​\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogTitle\":\"Als extern markeren van een of meer artikelen bevestigen\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogText\":\"Een of meer geselecteerde artikelen worden gemarkeerd als intern. Weet u zeker dat u wilt doorgaan?​\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_