    "contentjson": "{\"ThemeDesigner.Title\":\"مصمم النسق\",\"ThemeDesigner.SettingCategory\":\"إعداد المؤسسة\",\"ThemeDesigner.MainHeading\":\"العلامة التجارية والنسق\",\"ThemeDesigner.SelectThemeLabel\":\"تحديد نسق\",\"ThemeDesigner.PickThemeTooltip\":\"اختر نسقًا من القائمة\",\"ThemeDesigner.SystemTheme\":\"نسق النظام\",\"ThemeDesigner.CustomTheme\":\"النسق المخصص\",\"ThemeDesigner.CreateNewTheme\":\"إنشاء نسق جديد\",\"ThemeDesigner.SystemThemeModificationWarning\":\"لا يمكن تعديل نُسق النظام.\",\"ThemeDesigner.CurrentlyAppliedTheme\":\"مطبق حاليًا\",\"ThemeDesigner.ThemeName\":\"اسم النسق\",\"ThemeDesigner.CreateNew\":\"إنشاء جديد\",\"ThemeDesigner.ThemeNameTooltip\":\"اسم النسق.\",\"ThemeDesigner.ThemeappliedSuccessfully\":\"تم تطبيق النسق بنجاح\",\"ThemeDesigner.ThemeNameInputTooltip\":\"أدخل اسم النسق\",\"ThemeDesigner.ThemeNameRequiredErrorMessage\":\"اسم النسق مطلوب\",\"ThemeDesigner.LogoLabel\":\"شعار\",\"ThemeDesigner.ChooseLogoHelpText\":\"اختيار شعار للتطبيق\",\"ThemeDesigner.LogoImageHelpText\":\"تغيير أو تحديث الشعار\",\"ThemeDesigner.LogoMeasurements\":\"أقصى عرض 400px × ارتفاع 50px\",\"ThemeDesigner.LogoMeasurementsHelpText\":\"اختيار شعار بعرض أقصاه 400 بكسل وارتفاع 50 بكسل\",\"ThemeDesigner.RestoreDefaultLogoText\":\"استعادة الشعار الافتراضي\",\"ThemeDesigner.RestoreDefaultLogoHelpText\":\"إعادة تعيين الشعار وتلميح الأداة إلى الافتراضي\",\"ThemeDesigner.LogoTooltipLabel\":\"تلميح أداة الشعار\",\"ThemeDesigner.LogoTooltipHelpText\":\"أدخل اسم العلامة التجارية لشركتك كتلميح أداة للشعار\",\"ThemeDesigner.InvalidHexErrorMessage\":\"أدخل رمز لون سداسي صالح\",\"ThemeDesigner.ApplyThemeLabel\":\"حفظ وتطبيق النسق\",\"ThemeDesigner.ApplyThemeTooltip\":\"حفظ وتطبيق النسق.\",\"ThemeDesigner.DirtySaveDialogTitle\":\"تغييرات لم يتم حفظها\",\"ThemeDesigner.DirtySaveDialogMessage\":\"Your changes have not been published. To stay on this page and save your changes, select Cancel.\",\"ThemeDesigner.ErrorDialogTitle\":\"الخطأ\",\"ThemeDesigner.RetrieveThemeErrorDia