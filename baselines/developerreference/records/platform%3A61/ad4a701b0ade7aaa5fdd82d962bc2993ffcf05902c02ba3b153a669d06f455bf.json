    "contentjson": "{\"importMap.Process\":\"Обработва се...\",\"text.errorMessage\":\"При отговора се получава грешка!!!\",\"text.errorOccured\":\"Възникна грешка:\",\"text.unpublish\":\"Отмяна на публикуването на избраните правила за откриване на дублиращи се записи. Непубликуваните правила не се използват за откриване на дублиращ се запис. Искате ли да отмените публикуването на избраните правила?\",\"title.unpublish\":\"Отмяна на публикуването на правило\",\"text.publish\":\"Публикуването на правило създава код на съвпадение за всеки запис. Този процес работи във фонов режим. Можете да продължите да използвате Microsoft Dynamics 365, докато се публикува правилото.\",\"title.publish\":\"Публикуване на правило\",\"pick.list\":\"fieldpicklist\",\"text.req\":\"задължително\",\"operationName.Unpublish\":\"UnpublishDuplicateRule\",\"operationName.Publish\":\"PublishDuplicateRule\",\"action.restore\":\"Искате ли да възстановите {0}?\",\"action.restoreText\":\"Възстановяване\",\"action.cancelText\":\"Отказ\",\"action.confirmRestore\":\"Потвърждаване на възстановяване\",\"action.errorText\":\"Мрежова грешка\",\"action.restorationConfirm\":\"Заявка за потвърждение на {0}\",\"action.bodyText\":\"Наистина ли искате да възстановите записите, които са били изтрити от {0}?\",\"action.okText\":\"OK\",\"action.failedTitle\":\"Възстановяване е неуспешно\",\"action.failedSubtitle\":\"Възникна грешка по време на процеса на възстановяване.\",\"action.multiple.body\":\"С възстановяването на задачата {0} ще се възстановят всички записи, изтрити от задачата. За да продължите възстановяването на {0}, щракнете върху „OK“.\",\"action.processingText\":\"Обработва се...\",\"action.entityTypeMissing\":\"Името на типа обект не можа да бъде определено.\",\"action.restoreSuccess\":\"Възстановяването е успешно.\",\"action.learnMoreLabel\":\"Научете повече\"}",
