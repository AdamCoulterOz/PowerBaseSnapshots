    "contentjson": "{\"Create_Major_Confirmation_DialogTitle\":\"Vahvista artikkelin pääversion luonti\",\"Create_Minor_Confirmation_DialogTitle\":\"Vahvista artikkelin aliversion luonti\",\"KnowledgeArticle_Approve_Confirmation_DialogText\":\"Haluatko varmasti hyväksyä tämän artikkelin version?\",\"KnowledgeArticle_Approve_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n hyväksyntä\",\"KnowledgeArticle_Archive_Confirmation_DialogText\":\"Haluatko varmasti arkistoida tämän artikkelin version?\",\"KnowledgeArticle_Archive_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n arkistointi\",\"KnowledgeArticle_AssociateArticleArticle_DialogText\":\"Artikkeli täytyy valita.\",\"KnowledgeArticle_AssociateArticleCategory_DialogText\":\"Luokka täytyy valita.\",\"KnowledgeArticle_BulkApprove_Confirmation_DialogText\":\"Haluatko varmasti hyväksyä tämän artikkelin version?\",\"KnowledgeArticle_BulkArchive_Confirmation_DialogText\":\"Haluatko varmasti arkistoida tämän artikkelin version?\",\"KnowledgeArticle_BulkDiscard_Confirmation_DialogText\":\"Haluatko varmasti lähettää tämän artikkelin version roskakoriin?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogText\":\"Haluatko varmasti luoda tästä artikkelista uuden pääversion?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n pääversion luonti\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogText\":\"Ainakin yksi valituista artikkeleista merkitään ulkoiseksi. Haluatko varmasti jatkaa?​\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n merkintä ulkoiseksi\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogText\":\"Ainakin yksi valituista artikkeleista merkitään sisäiseksi. Haluatko varmasti jatkaa?​\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n merkintä sisäiseksi\",\"KnowledgeArticle_BulkMinor_Confirmation_DialogText\":\"Haluatko varmasti luoda tästä artikkelista uuden aliversion?\",\"KnowledgeArticle_BulkMinor_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n aliversion luonti\",\"KnowledgeArticle_BulkRevertToDraft_Confirmation_DialogText\":\"Haluatko varmasti palauttaa tämän artikkelin version luonnokseksi?\",\"KnowledgeArticle_ChkPublish_Confirmation_DialogText\":\"Olet julkaisemassa aiempaa versiota julkaistuna olevasta artikkelista. Haluatko jatkaa?\",\"KnowledgeArticle_ChkPublish_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n julkaisu\",\"KnowledgeArticle_CreateMajor_Confirmation_DialogText\":\"Tämä toiminto luo artikkelista uuden pääversion (v{0}.0), jonka sisältö on peräisin nykyisestä versiosta (v{1}.{2}). Haluatko jatkaa?\",\"KnowledgeArticle_CreateMinor_Confirmation_DialogText\":\"Tämä toiminto luo artikkelista uuden aliversion (v{0}.{1}), jonka sisäisin on peräisin nykyisestä versiosta (v{2}.{3}). Haluatko jatkaa?\",\"KnowledgeArticle_Discard_Confirmation_DialogText\":\"Haluatko varmasti lähettää tämän artikkelin version roskakoriin?\",\"KnowledgeArticle_Discard_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n siirtäminen roskakoriin\",\"KnowledgeArticle_ExpireOn_DialogText\":\"Artikkelin vanhenemispäiväksi on määritettävä julkaisupäivää myöhäisempi päivämäärä.\",\"KnowledgeArticle_Notify_Readonly\":\"Tätä tietoartikkelia ei voi muokata tässä. Voit tehdä artikkeliin muutoksia asiakaspalvelukeskuksessa.\",\"KnowledgeArticle_PublishDialog_PublishingDateTimeMessage\":\"Valitse toinen päivämäärä. Julkaisupäivän on oltava päivämäärä kuluvan päivän ja artikkelin vanhenemispäivän välillä.\",\"KnowledgeArticle_PublishDialog_SaveBlockMessage\":\"Tallennus on estetty. Päivitä ajoitetut tai julkaistut artikkelit valitsemalla valintanauhan Päivitä-toiminto\",\"KnowledgeArticle_Publish_ExpirationStateText\":\"Vanhenemistila-arvo on määritettävä\",\"KnowledgeArticle_Publish_ExpirationStatusText\":\"Vanhenemistila-arvo on määritettävä.\",\"KnowledgeArticle_Publish_PublishingDate\":\"Julkaistuajankohta-arvo on määritettävä.\",\"KnowledgeArticle_Reject_Note_Title\":\"Artikkelin tarkistus hylätty. Päivitä\",\"KnowledgeArticle_Restore_Confirmation_DialogText\":\"Haluatko varmasti palauttaa artikkelin? Artikkeli palautuu luonnostilaan.\",\"KnowledgeArticle_Restore_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n palautus\",\"KnowledgeArticle_RevertToDraft_Confirmation_DialogText\":\"Haluatko varmasti palauttaa tämän artikkelin version luonnokseksi?\",\"KnowledgeArticle_RevertToDraft_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n palautus luonnostilaan\",\"KnowledgeArticle_ReviewRejectReason_DialogText\":\"Tietoartikkelin hylkäämiselle on määritettävä syy.\",\"KnowledgeArticle_Save_PublishedStatus_Notification_DialogText\":\"Tämä artikkeli on julkaistu tai ajoitettu julkaistavaksi. Voit tallentaa ja julkaista muutoksesi käyttämällä Päivitä-toimintoa.\",\"KnowledgeArticle_TranslateDialog_LatestVersion\":\"Viimeisin versio\",\"KnowledgeArticle_TranslateDialog_MajorVersion\":\"Pääversionumero:\",\"KnowledgeArticle_TranslateDialog_MinorVersion\":\"Aliversionumero:\",\"KnowledgeArticle_TranslateDialog_NoTranslations\":\"Tälle kielelle ei ole käännöksiä\",\"KnowledgeArticle_TranslateDialog_TranslateLanguageMessage\":\"Valitse käännöksessä käytettävä kieli.\",\"KnowledgeArticle_Update_Confirmation_DialogText\":\"Haluatko tallentaa tähän artikkeliin tehdyt päivitykset? Päivitykset tulevat voimaan heti, vaikka artikkeli olisi jo julkaistu.\",\"KnowledgeArticle_Update_Confirmation_DialogTitle\":\"Vahvista artikkeli(e)n päivitys\",\"Msg_Progress_MOCA_Dialog\":\"Käsitellään...\",\"KnowledgeArticle_Warn_Notes_Attachment_FormNotificationText\":\"Voit hakea tietoartikkelin liitteitä portaalista käyttämällä tietoartikkelieditorin liitetoimintoa sen sijaan, että lisäisit liitteitä muistiinpano-osaan. Jos tietoartikkelin liitteiden synkronointi portaalin kanssa on käytössä, tietoartikkelin liitteet synkronoidaan automaattisesti muistiinpanojen liitteiden kanssa tässä. Lisätietoja on osoitteessa https://go.microsoft.com/fwlink/p/?linkid=2172080.\",\"KnowledgeArticle_Disclaimer_Allowed_Origins_FormNotificationText\":\"Päivitä sallittujen lähteiden luettelo, jos jokin artikkelin iFrame-kehys ei toimi tai näyttää virheen.\",\"KnowledgeArticle_Disclaimer_Allowed_Origins_Learn_More_FormNotificationText\":\"Lisätietoja\",\"KnowledgeArticle_Disclaimer_Non_Compliance_FormNotificationText\":\"Tämä artikkeli ei vastaa organisaation vaatimustenmukaisuusstandardeja. Tarkista sisältö ja yritä uudelleen.\",\"KnowledgeArticle_Disclaimer_Non_Compliance_Title_FormNotificationText\":\"Ongelma vaatimustenmukaisuudessa\",\"KnowledgeArticle_Disclaimer_For_Copilot_Articles\":\"Tekoälyn luoma sisältö voi olla virheellistä. Varmista ennen tekoälyn luoman sisällön käyttöä, että se on tarkkaa ja soveltuvaa.\",\"KnowledgeArticle_Disclaimer_See_Terms\":\"Näytä esiversion ehdot\"}",
