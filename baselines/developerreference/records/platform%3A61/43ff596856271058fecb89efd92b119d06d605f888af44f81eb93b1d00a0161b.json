    "contenthash": "aed4655b746889c114b6be6149be12e0d75795aa32a2e15edc4d7f13e619b25b",
    "contentjson": "{\"Create_Major_Confirmation_DialogTitle\":\"Xác nhận việc tạo phiên bản chính của bài viết\",\"Create_Minor_Confirmation_DialogTitle\":\"Xác nhận việc tạo phiên bản phụ của bài viết\",\"KnowledgeArticle_Approve_Confirmation_DialogText\":\"Bạn có chắc chắn muốn phê duyệt phiên bản này của bài viết không?\",\"KnowledgeArticle_Approve_Confirmation_DialogTitle\":\"Xác nhận việc phê duyệt (các) bài viết\",\"KnowledgeArticle_Archive_Confirmation_DialogText\":\"Bạn có chắc chắn muốn lưu trữ phiên bản này của bài viết không?\",\"KnowledgeArticle_Archive_Confirmation_DialogTitle\":\"Xác nhận việc lưu trữ (các) bài viết\",\"KnowledgeArticle_AssociateArticleArticle_DialogText\":\"Bạn phải chọn một bài viết.\",\"KnowledgeArticle_AssociateArticleCategory_DialogText\":\"Bạn phải chọn một Thể loại.\",\"KnowledgeArticle_BulkApprove_Confirmation_DialogText\":\"Bạn có chắc chắn muốn phê duyệt phiên bản này của bài viết không?\",\"KnowledgeArticle_BulkArchive_Confirmation_DialogText\":\"Bạn có chắc chắn muốn lưu trữ phiên bản này của bài viết không?\",\"KnowledgeArticle_BulkDiscard_Confirmation_DialogText\":\"Bạn có chắc chắn muốn gửi phiên bản này của bài viết tới thùng rác không?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogText\":\"Bạn có chắc chắn muốn tạo phiên bản chính mới của bài viết này không?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogTitle\":\"Xác nhận việc tạo phiên bản chính của (các) bài viết\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogText\":\"Một hoặc nhiều bài viết đã chọn sẽ được đánh dấu là bên ngoài. Bạn có chắc là bạn muốn tiến hành không?​\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogTitle\":\"Xác nhận đánh dấu (các) bài viết là của bên ngoài\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogText\":\"Một hoặc nhiều bài viết đã chọn sẽ được đánh dấu là nội bộ. Bạn có chắc là bạn muốn tiến hành không?​\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogTitle\":\"Xác nhận đánh dấu (các) bài viết là nội bộ\",\"KnowledgeArticle_BulkMinor_Confirmation_DialogText\":\"Bạn có chắc chắn muốn tạo phiên bản phụ mới của bài viết này không?\",\"KnowledgeArticle_BulkMinor_Confirmation_DialogTitle\":\"Xác nhận việc tạo phiên bản phụ của (các) bài viết\",\"KnowledgeArticle_BulkRevertToDraft_Confirmation_DialogText\":\"Bạn có chắc chắn muốn hoàn nguyên lại phiên bản này của bài viết về bản nháp không?\",\"KnowledgeArticle_ChkPublish_Confirmation_DialogText\":\"Bạn đang xuất bản phiên bản cũ hơn của bài viết hiện đã xuất bản. Bạn có muốn tiếp tục không?\",\"KnowledgeArticle_ChkPublish_Confirmation_DialogTitle\":\"Xác nhận việc xuất bản (các) bài viết\",\"KnowledgeArticle_CreateMajor_Confirmation_DialogText\":\"Thao tác này sẽ tạo phiên bản chính mới của Bài viết (v{0}.0) với nội dung từ phiên bản mà bạn hiện đang dùng trên (v{1}.{2}). Bạn có muốn tiếp tục không?\",\"KnowledgeArticle_CreateMinor_Confirmation_DialogText\":\"Thao tác này sẽ tạo phiên bản phụ mới của Bài viết (v{0}.{1}) với nội dung từ phiên bản mà bạn hiện đang ở trên (v{2}.{3}). Bạn có muốn tiếp tục không?\",\"KnowledgeArticle_Discard_Confirmation_DialogText\":\"Bạn có chắc chắn muốn gửi phiên bản này của bài viết tới thùng rác không?\",\"KnowledgeArticle_Discard_Confirmation_DialogTitle\":\"Xác nhận việc chuyển (các) bài viết vào thùng rác\",\"KnowledgeArticle_ExpireOn_DialogText\":\"Bạn phải đặt ngày hết hạn của bài viết vào thời điểm nào đó trong tương lai sau ngày xuất bản.\",\"KnowledgeArticle_Notify_Readonly\":\"Không thể chỉnh sửa bài viết trong cơ sở kiến thức này tại đây. Bạn có thể chỉnh sửa bài viết trong Trung tâm Dịch vụ Khách hàng.\",\"KnowledgeArticle_PublishDialog_PublishingDateTimeMessage\":\"Phải chọn ngày khác. Ngày xuất bản phải là ngày giữa ngày hôm nay và ngày hết hạn cho bài viết.\",\"KnowledgeArticle_PublishDialog_SaveBlockMessage\":\"Đã chặn tính năng lưu. Hãy nhấn hành động ruy-băng \\\"Cập nhật\\\" để cập nhật các bài viết được lên lịch hoặc đã xuất bản\",\"KnowledgeArticle_Publish_ExpirationStateText\":\"Bạn phải cấp giá trị cho Trạng thái Hết hạn\",\"KnowledgeArticle_Publish_ExpirationStatusText\":\"Bạn phải cấp giá trị cho Trạng thái Hết hạn.\",\"KnowledgeArticle_Publish_PublishingDate\":\"Bạn phải cấp giá trị cho Ngày và Thời gian Phát hành.\",\"KnowledgeArticle_Reject_Note_Title\":\"Đã từ chối Đánh giá Bài viết - Vui lòng Cập nhật\",\"KnowledgeArticle_Restore_Confirmation_DialogText\":\"Bạn có chắc chắn muốn khôi phục bài viết không? Bài viết sẽ lại ở trạng thái Bản nháp.\",\"KnowledgeArticle_Restore_Confirmation_DialogTitle\":\"Xác nhận việc lưu (các) bài viết\",\"KnowledgeArticle_RevertToDraft_Confirmation_DialogText\":\"Bạn có chắc chắn muốn hoàn nguyên lại phiên bản này của bài viết về bản nháp không?\",\"KnowledgeArticle_RevertToDraft_Confirmation_DialogTitle\":\"Xác nhận việc hoàn nguyên (các) bài viết về trạng thái bản nháp\",\"KnowledgeArticle_ReviewRejectReason_DialogText\":\"Bạn phải đưa ra lý do tại sao từ chối bài viết trong cơ sở kiến thức.\",\"KnowledgeArticle_Save_PublishedStatus_Notification_DialogText\":\"Bài viết này đã được xuất bản hoặc được lên lịch xuất bản. Để lưu và xuất bản các thay đổi, hãy dùng tác vụ Cập nhật.\",\"KnowledgeArticle_TranslateDialog_LatestVersion\":\"Phiên bản mới nhất\",\"KnowledgeArticle_TranslateDialog_MajorVersion\":\"Số phiên bản chính:\",\"KnowledgeArticle_TranslateDialog_MinorVersion\":\"Số phiên bản phụ:\",\"KnowledgeArticle_TranslateDialog_NoTranslations\":\"Không tồn tại bản dịch nào cho ngôn ngữ này\",\"KnowledgeArticle_TranslateDialog_TranslateLanguageMessage\":\"Chọn ngôn ngữ sẽ sử dụng cho bản dịch.\",\"KnowledgeArticle_Update_Confirmation_DialogText\":\"Bạn có muốn lưu các bản cập nhật được thực hiện cho bài viết này không? Các bản cập nhật đó sẽ có hiệu lực ngay lập tức ngay cả khi bài viết đã được xuất bản.\",\"KnowledgeArticle_Update_Confirmation_DialogTitle\":\"Xác nhận việc cập nhật (các) bài viết\",\"Msg_Progress_MOCA_Dialog\":\"Đang xử lý...\",\"KnowledgeArticle_Warn_Notes_Attachment_FormNotificationText\":\"Vui lòng sử dụng chức năng tệp đính kèm trong trình biên tập bài viết kiến thức thay vì thêm tệp đính kèm trong phần ghi chú để tìm kiếm tệp đính kèm bài viết kiến thức trong cổng thông tin. Nếu bạn đã bật “Đồng bộ hóa tệp đính kèm bài viết kiến thức với cổng thông tin”, thì tệp đính kèm bài viết kiến thức sẽ tự động được đồng bộ hóa với tệp đính kèm ghi chú tại đây. Tìm hiểu thêm tại https://go.microsoft.com/fwlink/p/?linkid=2172080.\",\"KnowledgeArticle_Disclaimer_Allowed_Origins_FormNotificationText\":\"Cập nhật danh sách nguồn gốc được phép của bạn nếu bất kỳ iframe nào trong bài viết không hoạt động hoặc hiển thị lỗi.\",\"KnowledgeArticle_Disclaimer_Allowed_Origins_Learn_More_FormNotificationText\":\"Tìm hiểu thêm\",\"KnowledgeArticle_Disclaimer_Non_Compliance_FormNotificationText\":\"Bài viết này không đáp ứng các tiêu chuẩn tuân thủ của tổ chức bạn. Hãy sửa lại nội dung rồi thử lại.\",\"KnowledgeArticle_Disclaimer_Non_Compliance_Title_FormNotificationText\":\"Vấn đề tuân thủ\",\"KnowledgeArticle_Disclaimer_For_Copilot_Articles\":\"Nội dung do AI tạo ra có thể không chính xác. Hãy đảm bảo rằng nội dung do AI tạo là chính xác và phù hợp trước khi sử dụng.\",\"KnowledgeArticle_Disclaimer_See_Terms\":\"Xem điều khoản về bản xem trước\"}",
