    "contentjson": "{\"Create_Major_Confirmation_DialogTitle\":\"Confirmar criação da versão principal do artigo\",\"Create_Minor_Confirmation_DialogTitle\":\"Confirmar criação da versão secundária do artigo\",\"KnowledgeArticle_Approve_Confirmation_DialogText\":\"Tem certeza de que deseja aprovar esta versão do artigo?\",\"KnowledgeArticle_Approve_Confirmation_DialogTitle\":\"Confirmar aprovação do(s) artigo(s)\",\"KnowledgeArticle_Archive_Confirmation_DialogText\":\"Tem certeza de que deseja arquivar esta versão do artigo?\",\"KnowledgeArticle_Archive_Confirmation_DialogTitle\":\"Confirmar arquivamento do(s) artigo(s)\",\"KnowledgeArticle_AssociateArticleArticle_DialogText\":\"Você deve selecionar um artigo.\",\"KnowledgeArticle_AssociateArticleCategory_DialogText\":\"Selecione uma Categoria.\",\"KnowledgeArticle_BulkApprove_Confirmation_DialogText\":\"Tem certeza de que deseja aprovar esta versão do artigo?\",\"KnowledgeArticle_BulkArchive_Confirmation_DialogText\":\"Tem certeza de que deseja arquivar esta versão do artigo?\",\"KnowledgeArticle_BulkDiscard_Confirmation_DialogText\":\"Tem certeza de que deseja enviar esta versão do artigo para a lixeira?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogText\":\"Tem certeza de que deseja criar uma nova versão principal deste artigo?\",\"KnowledgeArticle_BulkMajor_Confirmation_DialogTitle\":\"Confirmar criação da versão principal do(s) artigo(s)\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogText\":\"Um ou mais artigos selecionados serão marcados como externos. Tem certeza de que deseja continuar?​\",\"KnowledgeArticle_BulkMarkExternal_Confirmation_DialogTitle\":\"Confirmar para marcar artigo(s) como externo(s)\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogText\":\"Um ou mais artigos selecionados serão marcados como internos. Tem certeza de que deseja continuar?​\",\"KnowledgeArticle_BulkMarkInternal_Confirmation_DialogTitle\":\"Confirmar para marcar artigo(s) como interno(s)\",\"KnowledgeArtic