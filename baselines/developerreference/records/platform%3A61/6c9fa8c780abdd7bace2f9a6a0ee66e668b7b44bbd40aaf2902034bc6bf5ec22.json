    "contentjson": "{\"ThemeDesigner.Title\":\"Тақырып құрастырушысы\",\"ThemeDesigner.SettingCategory\":\"Ұйым орнатуы\",\"ThemeDesigner.MainHeading\":\"Тауар белгісі және тақырып\",\"ThemeDesigner.SelectThemeLabel\":\"Тақырыпты таңдау\",\"ThemeDesigner.PickThemeTooltip\":\"Тізімнен тақырыпты таңдау\",\"ThemeDesigner.SystemTheme\":\"Жүйе тақырыбы\",\"ThemeDesigner.CustomTheme\":\"Реттелмелі тақырып\",\"ThemeDesigner.CreateNewTheme\":\"Жаңа тақырып жасау\",\"ThemeDesigner.SystemThemeModificationWarning\":\"Жүйе тақырыптары өзгертілмейді.\",\"ThemeDesigner.CurrentlyAppliedTheme\":\"Ағымда қолданылған\",\"ThemeDesigner.ThemeName\":\"Бөлім атауы\",\"ThemeDesigner.CreateNew\":\"Жаңа\",\"ThemeDesigner.ThemeNameTooltip\":\"Тақырып аты.\",\"ThemeDesigner.ThemeappliedSuccessfully\":\"Тақырып сәтті қолданылды\",\"ThemeDesigner.ThemeNameInputTooltip\":\"Тақырып атауын енгізіңіз\",\"ThemeDesigner.ThemeNameRequiredErrorMessage\":\"Тақырып атауы міндетті\",\"ThemeDesigner.LogoLabel\":\"Логотип\",\"ThemeDesigner.ChooseLogoHelpText\":\"Бағдарлама логотипін таңдау\",\"ThemeDesigner.LogoImageHelpText\":\"Логотипті өзгерту немесе жаңарту\",\"ThemeDesigner.LogoMeasurements\":\"400px максималды ені x 50px биіктігі\",\"ThemeDesigner.LogoMeasurementsHelpText\":\"Максимум ені 400 px және биіктігі 50 px болатын логотипті таңдау\",\"ThemeDesigner.RestoreDefaultLogoText\":\"Әдепкі логотипті қалпына келтіру\",\"ThemeDesigner.RestoreDefaultLogoHelpText\":\"Логотип пен сөзкөмекті әдепкі күйге қайта орнату\",\"ThemeDesigner.LogoTooltipLabel\":\"Логотиптің сөзкөмегі\",\"ThemeDesigner.LogoTooltipHelpText\":\"Компания бренді атауын логотип сөзкөмегі ретінде енгізу\",\"ThemeDesigner.InvalidHexErrorMessage\":\"Жарамды он алты таңбалы түс кодын енгізу\",\"ThemeDesigner.ApplyThemeLabel\":\"Тақырыпты сақтау және қолдану\",\"ThemeDesigner.ApplyThemeTooltip\":\"Тақырыпты сақтаңыз және қолданыңыз.\",\"ThemeDesigner.DirtySaveDialogTitle\":\"Сақталмаған өзгерістер\",\"ThemeDesigner.DirtySaveDialogMessage\":\"Your changes have not been published. To stay on this page and save your changes, select Cancel.\",\"ThemeDesigner.ErrorDialogTitle\":\"Қате\",\"ThemeDesigner.RetrieveThemeErrorDialogMessage\":\"Тақырыптар тізімін шығару кезінде қате орын алды. Бетті жаңартыңыз. Егер мәселе шешілмесе, әкімшіге хабарласыңыз.\",\"ThemeDesigner.ApplyThemeErrorDialogMessage\":\"Тақырыпты қолданған кезде қате пайда болды. Әрекетті кейінірек қайталаңыз. Егер мәселе шешілмесе, әкімшіге хабарласыңыз.\",\"ThemeDesigner.InvalidImageNameErrorDialogMessage\":\"Жүктеп салынған кескін атында тек әріптер, сандар, нүктелер және бірізді алдыңғы қисық сызықтар болуы мүмкін.\",\"ThemeDesigner.HexColorCode\":\"Он алты таңбалы түс коды\",\"ThemeDesigner.SelectLogo\":\"Логотипті таңдау\",\"ThemeDesigner.ThemeColor\":\"Тақырып түсі\",\"ThemeDesigner.Loading.ApplyTheme\":\"Тақырып қолдану\",\"ThemeDesigner.Logo.FileSize.ErrorMessage\":\"Жүктеп салынған файл өлшемі тым үлкен. Файл өлшемі {0} МБ аспауы керек.\",\"ThemeDesigner.Logo.FileType.ErrorMessage\":\"Жарамсыз кескін түрі. Тек JPG, PNG, GIF немесе SVG пайдаланыңыз.\",\"ThemeDesigner.LogoPicker.Tooltip\":\"Ұйым логотипі ретінде пайдаланылатын кескінді жүктеп салыңыз. Файл өлшем {0} МБ аспауы керек. Қолдау көрсетілетін файл түрлері: JPG, PNG, GIF және SVG.\",\"ThemeDesigner.NavBarColor\":\"Навигация тақтасы түсі\",\"ThemeDesigner.MainColor\":\"Негізгі түс\",\"ThemeDesigner.AccentColor\":\"Екпін белгісі түсі\",\"ThemeDesigner.NavBarColorTooltip\":\"Навигация тақтасының фондық түсін таңдау\",\"ThemeDesigner.MainColorTooltip\":\"Пәрмен жолағы, түймелер және қойыншалар үшін негізгі тақырып түсін таңдаңыз.\",\"ThemeDesigner.AccentColorTooltip\":\"Процесс басқару құралы үшін қосалқы тақырып түсін таңдаңыз.\"}",
