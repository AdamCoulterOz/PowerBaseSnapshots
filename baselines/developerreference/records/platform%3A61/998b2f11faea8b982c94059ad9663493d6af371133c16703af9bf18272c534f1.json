    "contentjson": "{\"importMap.Process\":\"Өңделуде...\",\"text.errorMessage\":\"Жауап қатенің пайда болуына әкелді!!!\",\"text.errorOccured\":\"Қате пайда болды:\",\"text.unpublish\":\"Таңдалған қайталанатын деректерді іздеу ережесін (ережелерін) жариялауды болдырмау. Жарияланбаған ережелер қайталанатын деректерді іздеу үшін пайдаланылмайды. Таңдалған ереже(лер) жариялануын болдырмау керек пе?\",\"title.unpublish\":\"Ереже жариялауын болдырмау\",\"text.publish\":\"Ережені жариялау әрбір жазба үшін іздеу кодын жасайды. Бұл үрдіс өңде іске қосылады. Microsoft Dynamics 365 ережені жариялаған кезде оны пайдалана бере аласыз.\",\"title.publish\":\"Ережені жариялау\",\"pick.list\":\"fieldpicklist\",\"text.req\":\"қажетті\",\"operationName.Unpublish\":\"UnpublishDuplicateRule\",\"operationName.Publish\":\"PublishDuplicateRule\",\"action.restore\":\"{0} қалпына келтіргіңіз келе ме?\",\"action.restoreText\":\"Қалпына келтіру\",\"action.cancelText\":\"Баc тарту\",\"action.confirmRestore\":\"Қалпына келтіруді растау\",\"action.errorText\":\"Желі қатесі\",\"action.restorationConfirm\":\"{0} Растауды қалпына келтіру\",\"action.bodyText\":\"{0} арқылы жойылған жазбаларды қалпына келтіргіңіз келетініне сенімдісіз бе?\",\"action.okText\":\"OK\",\"action.failedTitle\":\"Қалпына келтіру сәтсіз аяқталды\",\"action.failedSubtitle\":\"Қалпына келтіру процесі барысында қате орын алды.\",\"action.multiple.body\":\"{0} тапсырмасын қалпына келтіру тапсырма жойған барлық жазбаны қалпына келтіреді. {0} тапсырмасын қалпына келтіруді жалғастыру үшін, «Ok» түймесін басыңыз.\",\"action.processingText\":\"Өңделуде...\",\"action.entityTypeMissing\":\"Нысан түрінің атауын анықтау мүмкін болмады.\",\"action.restoreSuccess\":\"Қалпына келтіру сәтті орындалды.\",\"action.learnMoreLabel\":\"Қосымша ақпарат\"}",
