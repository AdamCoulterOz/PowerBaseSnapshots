    "contenthash": "85dc6897317b40a62c972e86251680fadb42bb9f7e1ebfc468d9a7da89ef2b66",
    "contentjson": "{\"SLA_DefaultSLASelectionConfirmDialogText\":\"Bạn có chắc chắn muốn đặt bản ghi thỏa thuận cấp độ dịch vụ (SLA) này thành mặc định đối với thực thể đã chỉ định không?\",\"SLA_DefaultSLASelectionConfirmDialogTitle\":\"Xác nhận Đặt thành Mặc định\",\"SLA_DefaultSLAOverrideConfirmDialogText\":\"Bạn có một bản ghi thỏa thuận cấp độ dịch vụ (SLA) khác được đặt thành mặc định cho thực thể {0}. Bạn muốn đánh dấu SLA đã chọn làm mặc định thay thế không?\",\"SLA_DefaultSLAOverrideConfirmDialogTitle\":\"Đổi Thỏa thuận Cấp độ Dịch vụ mặc định\",\"SLA_SettingInactiveSLAAsDefaultAlertText\":\"Bạn không thể đặt SLA không hoạt động làm mặc định.\",\"SLA_SettingInactiveSLAAsDefaultAlertTitle\":\"Không thể đặt thành mặc định\",\"SLA_DefaultSLAWarning\":\"SLA đã chọn hiện đã là mặc định\",\"SLA_DefaultSLASetttingInProgress\":\"Đặt SLA mặc định\",\"SLA_ErrorResettingDefaultSLA\":\"Đã xảy ra lỗi khi cập nhật Thỏa thuận Cấp độ Dịch vụ mặc định\",\"SLA_ErrorSettingNewSLA\":\"Đã xảy ra lỗi khi đặt SLA Mặc định mới\",\"SLAItem_ConfigureActionsGeneralNotification\":\"Nhấp vào Cấu hình Hành động để thiết lập các hành động thành công, cảnh báo và thất bại.\",\"SLAItem_ConfigureActionsSetupNotification\":\"Hành động thành công, cảnh báo và thất bại chưa được thiết lập. Nhấp vào Cấu hình Hành động để thiết lập.\",\"SLAItem_WarningTimeHigherThanFailureTimeAlert\":\"Cảnh báo sau khoảng thời gian không được lớn hơn thất bại sau khoảng thời gian\",\"SLAItem_SuccessConditionsEmptyAlert\":\"Không được để trống điều kiện thành công\",\"SLAItem_PauseConditionsEmptyAlert\":\"Không được để trống điều kiện tạm dừng khi nút bật tắt thay thế cấu hình tạm dừng ở trạng thái bật\",\"SLAItem_KPIEmptyAlert\":\"không được để trống KPI\",\"SLAItem_Notification_SLA_ActivatedState\":\"Hủy kích hoạt Thỏa thuận Cấp độ Dịch vụ để chỉnh sửa mục Thỏa thuận Cấp độ Dịch vụ\",\"SLAKPI_Activate\":\"Kích hoạt\",\"SLAKPI_Deactivate\":\"Hủy kích hoạt\",\"SLAKPI_Deactivate_Message\":\"Bạn có muốn hủy kích hoạt Chỉ số Đánh giá Hiệu suất Chính cho thực thể {0} đã chọn không?\",\"SLAKPI_Activate_Message\":\"Bạn có muốn kích hoạt Chỉ số Đánh giá Hiệu suất Chính cho thực thể {0} đã chọn không?\",\"Progress_Message\":\"Đang cập nhật Chỉ số Đánh giá Hiệu suất Chính\",\"SLAKPI_Deactivate_Title\":\"Xác nhận Hủy kích hoạt\",\"SLAKPI_Activate_Title\":\"Xác nhận Kích hoạt\",\"SLA_Cannot_Edit_In_UC\":\"Đây là một bản ghi cũ. Để chỉnh sửa bản ghi này, vui lòng truy cập máy khách web cũ.\",\"SLA_Cannot_Edit_In_WC\":\"Không thể chỉnh sửa bản ghi này ở đây. Vui lòng đến ứng dụng giao diện hợp nhất để chỉnh sửa.\",\"SLA_UC_Preview_Text\":\"Các hành động được sử dụng để thực hiện tập hợp các tác vụ, tùy thuộc vào việc các tiêu chí có được đáp ứng hay không. Trước khi các hành động có thể được xác định, mục Thỏa thuận Cấp độ Dịch vụ phải được lưu. Nhấp {0} để biết thêm thông tin.\",\"SLA_AdvancedPauseConfig_Text\":\"Định cấu hình các điều kiện tạm dừng trong phần này để thay thế cấu hình tạm dừng cấp thực thể được xác định trong Cấu hình dịch vụ và cấu hình tạm dừng cấp Chỉ số đánh giá hiệu suất chính. {0}.\",\"SLA_KPIAdvancedPauseConfig_Text\":\"Định cấu hình các điều kiện tạm dừng trong phần này để thay thế cấu hình tạm dừng cấp thực thể được xác định trong Cấu hình dịch vụ. {0}.\",\"SLA_UC_Preview_FeatureDocumentation_Hyperlink_Label\":\"tài liệu tính năng\",\"SLA_AdavncedPauseConfig_Hyperlink_Label\":\"Tìm hiểu thêm\",\"SLAKPI_LearnMoreLink_Text\":\"Thực thể cần được bật cho Thỏa thuận cấp độ dịch vụ. {0}.\",\"SLAKPI_Hyperlink_Label\":\"Tìm hiểu thêm\",\"SLAItem_ConditionControl_Notification_Text\":\"Bạn nên tránh đặt cấu hình tùy chọn Áp dụng khi và Tiêu chí thành công trên cùng một thuộc tính.\",\"SLAItem_ConditionOnSameAttributeAlert\":\"Bạn nên tránh đặt cấu hình tùy chọn Áp dụng khi và Tiêu chí thành công trên cùng một thuộc tính. Bạn có muốn tiếp tục không?\",\"SLAKPI_BusinessProcessError_Title\":\"Lỗi quy trình công việc\",\"SDKMessagingStepNotInActiveState\":\"Một số bước thông báo SDK {0} được liên kết có thể không ở trạng thái hiện hoạt. Vui lòng kích hoạt Bước thông báo SDK trước khi kích hoạt Thỏa thuận cấp độ dịch vụ.\",\"SLAIsDisabledInSetting\":\"Tùy chọn thiết đặt được liên kết ‘Tắt Thỏa thuận cấp độ dịch vụ’ được bật trong phần thiết đặt cấu hình dịch vụ. Vui lòng hủy kích hoạt tùy chọn thiết đặt đó trước khi kích hoạt Thỏa thuận cấp độ dịch vụ.\",\"WorkflowNotInActiveState\":\"Một số quy trình làm việc {0} được liên kết có thể không ở trạng thái hiện hoạt. Vui lòng kích hoạt quy trình làm việc trước khi kích hoạt Thỏa thuận cấp độ dịch vụ.\",\"SLAItem_ApplicableAndSuccessSameAttribute\":\"Bạn nên tránh đặt cấu hình tùy chọn Áp dụng khi và Tiêu chí thành công trên cùng một thuộc tính\",\"WorkflowOwnerIsDisabled\":\"Cần cập nhật chủ sở hữu trong Quy trình làm việc theo SLA sau: {0} với người dùng hiện hoạt.\",\"NoSLASetAsDefault\":\"Thỏa thuận Cấp độ Dịch vụ mặc định không được duy trì cho thực thể {0}.\",\"OpenLearnMoreForSetAsDefaultSLA\":\"Tìm hiểu thêm\",\"SLAKPI_Recommendation_Entityname\":\"Thực thể cần được bật cho Thỏa thuận cấp độ dịch vụ.\",\"SLAKPI_Recommendation_KPIField\":\"Chỉ số đánh giá hiệu suất chính được tính dựa trên Thực thể đã chọn.\",\"SLAKPI_Recommendation_PrimaryEntity\":\"Thực thể cần được bật cho Thỏa thuận cấp độ dịch vụ.\",\"SLA_WebClientDeprecationNotification\":\"Có hiệu lực từ ngày 01 tháng 04 năm 2023, các Thỏa thuận cấp độ dịch vụ (SLA) cũ trên máy khách web không được dùng nữa trước đó, đã quá thời gian Kết thúc hỗ trợ (EoS). Bạn cần di chuyển những SLA cũ đã được tạo trên máy khách web sang trải nghiệm Giao diện Hợp nhất ngay lập tức để tránh nguy cơ không sử dụng được sản phẩm và dịch vụ. Để biết thêm thông tin về cách di chuyển các mục, hãy xem {0}\",\"SLA_WebClientDeprecation_Ack_Button_Text\":\"Tôi xác nhận\",\"SLA_WebClientDeprecation_Cancel_Button_Text\":\"Hủy\",\"SLAKPI_Activation_Error_Message\":\"Không thể kích hoạt SLAKPI, vui lòng kích hoạt từ mục quản lý SLAKPI.\",\"SLAKPI_Performance_Indicator_Notification\":\"Chỉ số đánh giá hiệu suất chính theo Thỏa thuận cấp độ dịch vụ là các chỉ số hiệu suất\",\"SLA_ChangedAttribiteNullNotification\":\"Bạn cần kích hoạt lại Thỏa thuận cấp độ dịch vụ {0} để khắc phục những vấn đề đã xác định được với các điều kiện trong đó. Để biết thêm thông tin, hãy xem {1}\",\"SLA_RelatedEntitiesNotification\":\"Những thực thể liên quan được đặt cấu hình trong các điều kiện cho Mục {{0}} thuộc Thỏa thuận cấp độ dịch vụ không được hỗ trợ đầy đủ. Để biết thêm thông tin, hãy xem – {1}\",\"SLA_DisableLegacyCreateSLADialogDepreciationText\":\"Kể từ ngày 1 tháng 10 năm 2020, Thỏa thuận cấp độ dịch vụ không còn được dùng trong máy khách web. Để biết thêm thông tin, hãy truy cập - {0}\",\"SLA_DisableLegacyCreateSLADialogConfirmationText\":\"Chọn 'OK' để tiếp tục tạo Thỏa thuận cấp độ dịch vụ mới trong Giao diện hợp nhất.\",\"SLAWorkingHoursEmptyNotification\":\"Lịch doanh nghiệp được liên kết với Thỏa thuận cấp độ dịch vụ {0} chưa có giờ làm việc.\"}",
